# --- Runtime --------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- Database -------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=xvault

# --- Redis (BullMQ) -------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# --- Auth -----------------------------------------------------------------
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SAMESITE=lax

# --- X session encryption -------------------------------------------------
# MUST be a base64-encoded 32-byte key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key invalidates every stored X session (users must reconnect).
SESSION_ENCRYPTION_KEY=

# --- Scraping -------------------------------------------------------------
SCRAPE_INTERVAL_HOURS=72
# Set to false to watch the browser while debugging selectors.
SCRAPE_HEADLESS=true
SCRAPE_MAX_BOOKMARKS_PER_RUN=1000
SCRAPE_KNOWN_STREAK_STOP=25

# --- Cloudflare R2 (media archive) ----------------------------------------
# Leave blank to run without media archival: the API and worker still start and
# the media worker skips its work with a warning. The bucket must stay PRIVATE —
# media is served to the browser through short-lived presigned GET URLs.
#
# Create the credentials in the Cloudflare dashboard (see docs) and paste them
# here. Never commit real values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Key prefix for everything this app stores, i.e. <prefix>/<userId>/tweets/<tweetId>/...
R2_ROOT_PREFIX=xvault
# How long a presigned media URL stays valid. 6h keeps an open library tab working
# while still expiring; lower it if you want leaked URLs to die sooner.
R2_SIGNED_URL_TTL_SECONDS=21600

# --- AI categorization (optional) ----------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_SIMILARITY_THRESHOLD=0.82
AI_HUMAN_EDIT_LOCK_MINUTES=1440
